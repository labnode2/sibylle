# Sibylle in production: the interface built into this image, the API and its WebSocket relayed
# to the api service, and the deploy hooks relayed to webhook on the VM. Visitors come through
# Cloudflare, then Nginx Proxy Manager (NPM), the VM's reverse proxy, which terminates TLS and
# forwards to port 8443 here, in plain HTTP, over Docker's `proxy` network (compose.prod.yml).
# Before nginx starts, the image's entrypoint fills in the site's domain (SIBYLLE_DOMAIN, from
# PUBLIC_ORIGIN).

server_tokens off;

# The visitor's address, which the API gets in X-Forwarded-For: Cloudflare's CF-Connecting-IP, as
# NPM passes it on. Only containers reach this port (Docker's addresses); with Authenticated
# Origin Pulls on NPM's side (deploy/README.md), only Cloudflare reaches NPM for this site, so
# nobody else sets that header.
set_real_ip_from 172.16.0.0/12;
real_ip_header CF-Connecting-IP;

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

# Docker's DNS: a deploy recreates the api container, whose address nginx then looks up again.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream api {
    zone api 64k;
    server api:8000 resolve;
}

server {
    listen 8443;
    server_name ${SIBYLLE_DOMAIN};

    # No access log: no visitor address is written down.
    access_log off;
    root /usr/share/nginx/html;
    # Above the 5 MB of an image sent with a prono, so that the API gives its own error.
    client_max_body_size 8m;

    gzip on;
    gzip_vary on;
    gzip_types text/css text/plain application/javascript application/json
        application/manifest+json image/svg+xml;

    # The application: every address the browser does not find as a file is the single page's.
    location / {
        include /etc/nginx/conf.d/sibylle/headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }

    # Vite's files, named after their content.
    location /assets/ {
        include /etc/nginx/conf.d/sibylle/headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        include /etc/nginx/conf.d/sibylle/headers.inc;
        add_header Cache-Control "no-cache" always;
        default_type application/manifest+json;
    }

    # The public press card, which another site may show in an iframe (research.md J11): the
    # single page served here, with its own headers (an internal redirect would take those of /).
    location /carte/ {
        include /etc/nginx/conf.d/sibylle/card-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }

    location /api/ {
        include /etc/nginx/conf.d/sibylle/headers.inc;
        proxy_pass http://api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # The WebSocket: the server pings every 25 s, under the idle timeouts of nginx, NPM and
    # Cloudflare.
    location = /api/ws {
        include /etc/nginx/conf.d/sibylle/headers.inc;
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # The deploy hooks (deploy/webhook/hooks.yaml), served by webhook on the VM's docker0
    # bridge. Both answer at once: the default timeouts are enough.
    location /hooks/ {
        limit_except POST {
            deny all;
        }
        proxy_pass http://host.docker.internal:9000;
    }
}

# Inside the container only (the port is not published): the health check of compose.prod.yml.
server {
    listen 8080;
    access_log off;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}
