# Copier en deploy/.env et remplir. Aucune valeur réelle dans ce fichier.

# development, test ou production
ENVIRONMENT=development

# Base de données (le Compose crée l'utilisateur et la base au premier démarrage)
POSTGRES_USER=sibylle
POSTGRES_PASSWORD=
POSTGRES_DB=sibylle
DATABASE_URL=postgresql+asyncpg://sibylle:<mot de passe>@localhost:5432/sibylle

# Adresse publique de l'appli, sans barre finale (sert au contrôle de l'en-tête Origin et aux liens des e-mails)
PUBLIC_ORIGIN=http://localhost:5173

# Développement : l'adresse où `make dev` sert l'interface. localhost par défaut ; l'IP du PC sur
# le réseau local (par exemple 192.168.71.12) pour ouvrir l'appli depuis un téléphone. `make dev`
# règle alors PUBLIC_ORIGIN sur http://<UI_HOST>:<port>.
UI_HOST=localhost

# E-mails : Mailpit en développement (localhost:1025), relais SMTP de Brevo en production :
# SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER = l'identifiant SMTP affiché par
# Brevo, SMTP_PASSWORD = une clé SMTP créée chez Brevo, MAIL_FROM sur un domaine validé chez Brevo.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Sibylle <ne-pas-repondre@exemple.fr>

# Connexion par Keycloak (specs/002-keycloak-auth/contracts/auth.md). OIDC_ISSUER : l'adresse
# publique du realm, où va le navigateur et que portent les jetons. KEYCLOAK_INTERNAL_URL :
# l'adresse où le serveur appelle Keycloak (échange du code, clés, API d'admin), vide pour celle
# d'OIDC_ISSUER. OIDC_CLIENT_ID et OIDC_CLIENT_SECRET : le client du serveur dans le realm.
# Développement : le Keycloak de `make keycloak` et le client `sibylle` de keycloak/dev-realm.json,
# dont le secret ne vaut que pour ce Keycloak local. Production :
# OIDC_ISSUER=https://auth.sibylle.cc/realms/sibylle, KEYCLOAK_INTERNAL_URL posée par le Compose,
# le secret donné par `keycloak/terraform/tofu.sh output -raw client_secret`.
OIDC_ISSUER=http://localhost:8280/realms/sibylle
KEYCLOAK_INTERNAL_URL=
OIDC_CLIENT_ID=sibylle
OIDC_CLIENT_SECRET=sibylle-dev-secret

# Notifications push (générées par `sibylle gen-secrets`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.fr

# Images jointes aux pronos
UPLOAD_DIR=./data/uploads

# Horloge : system, ou fake en développement et en test seulement
SIBYLLE_CLOCK=system
SIBYLLE_FAKE_CLOCK_FILE=./.fake-clock

# DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO

# Production (deploy/compose.prod.yml, deploy/README.md) : ENVIRONMENT=production,
# PUBLIC_ORIGIN=https://sibylle.cc (nginx en tire aussi le domaine du site), les secrets de
# `sibylle gen-secrets`, les e-mails de Brevo, le realm et le client de Keycloak (OIDC_*).
# DATABASE_URL, UPLOAD_DIR et KEYCLOAK_INTERNAL_URL y sont posés par le Compose. Au besoin, sans
# commentaire en fin de ligne :
# Tags de l'image du serveur et de celle du site (`sha-<commit>` fige une version, d'un commit qui
# a construit cette image ; main par défaut)
# SIBYLLE_BACKEND_TAG=main
# SIBYLLE_WEB_TAG=main
# Dossier des données sur la VM : db/ (la base, à l'UID 2005) et uploads/ (les images, à l'UID
# 10001)
# SIBYLLE_DATA_DIR=/mnt/data/sibylle
# Sauvegardes : dossier (backups/ à côté de deploy/ par défaut) et jours gardés
# BACKUP_DIR=/opt/sibylle/backups
# BACKUP_KEEP_DAYS=14
# Copie chiffrée de la sauvegarde de nuit : clé publique age, et destination rsync sur le VPS
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_REMOTE=sibylle@vps.example:/srv/sauvegardes/sibylle/
# Secondes laissées à chaque service pour se dire en bonne santé après une mise à jour
# DEPLOY_WAIT_TIMEOUT=300
# Journaux des mises à jour lancées par le crochet, gardés 30 jours (deploy-logs/ à côté de
# deploy/ par défaut)
# DEPLOY_LOG_DIR=/opt/sibylle/deploy-logs
# Salon Discord prévenu de chaque mise à jour faite ou manquée : l'URL d'un webhook du salon
# (Paramètres du salon → Intégrations → Webhooks)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
