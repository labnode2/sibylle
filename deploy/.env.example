# Copier en deploy/.env et remplir. Aucune valeur réelle dans ce fichier.

# development, test ou production
ENVIRONMENT=development

# Base de données (le Compose crée l'utilisateur et la base au premier démarrage)
POSTGRES_USER=sibylle
POSTGRES_PASSWORD=
POSTGRES_DB=sibylle
DATABASE_URL=postgresql+asyncpg://sibylle:<mot de passe>@localhost:5432/sibylle

# Adresse publique de l'appli, sans barre finale (sert au contrôle de l'en-tête Origin et aux liens des e-mails)
PUBLIC_ORIGIN=http://localhost:5173

# E-mails : Mailpit en développement (localhost:1025), relais SMTP de Brevo en production :
# SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER = l'identifiant SMTP affiché par
# Brevo, SMTP_PASSWORD = une clé SMTP créée chez Brevo, MAIL_FROM sur un domaine validé chez Brevo.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Sibylle <ne-pas-repondre@exemple.fr>

# Notifications push (générées par `sibylle gen-secrets`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.fr

# Images jointes aux pronos
UPLOAD_DIR=./data/uploads

# Horloge : system, ou fake en développement et en test seulement
SIBYLLE_CLOCK=system
SIBYLLE_FAKE_CLOCK_FILE=./.fake-clock

# DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO
