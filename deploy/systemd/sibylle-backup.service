# The production backup (deploy/backup/backup.sh), run every night by sibylle-backup.timer.
# `systemctl start sibylle-backup` makes one right away.
[Unit]
Description=Sibylle: production backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=sibylle
Group=sibylle
ExecStart=/opt/sibylle/deploy/backup/backup.sh nightly
