# frpc on the machine: a single TCP tunnel from the VPS's frps to nginx. Visitors only reach the
# site through Cloudflare, which talks to it on 443 alone (it answers plain HTTP itself), so there
# is no tunnel for port 80. nginx expects the PROXY protocol on this port: it carries the address
# that reached frps, a Cloudflare edge or someone who went to the VPS directly. Copy it to
# /etc/frp/frpc.toml (or add the proxy to an frpc that already runs) with the VPS's address and
# token; no real value here. deploy/README.md describes the rest.
serverAddr = "vps.example.org"
serverPort = 7000
auth.method = "token"
auth.token = "the frps token"

[[proxies]]
name = "sibylle-https"
type = "tcp"
localIP = "127.0.0.1"
# SIBYLLE_HTTPS_PORT in deploy/.env (8443 by default).
localPort = 8443
remotePort = 443
transport.proxyProtocolVersion = "v2"
